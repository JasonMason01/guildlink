# Bot token from the Discord Developer Portal, Bot tab.
DISCORD_TOKEN=

# Application id, OAuth2 tab.
DISCORD_CLIENT_ID=

# OAuth2 client secret. Reset it if it is ever exposed.
DISCORD_CLIENT_SECRET=

# Must match a redirect under OAuth2 → Redirects.
# This computer: http://localhost:3000/auth/callback
# Other people: https://panel.example.com/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Long random string. Used to seal session cookies and stored Discord tokens.
SESSION_SECRET=

PORT=3000
# 127.0.0.1 accepts connections from this computer.
# 0.0.0.0 accepts connections on this port from other computers.
HOST=127.0.0.1

# Optional. Defaults to %LOCALAPPDATA%\guildlink\guildlink.db so OneDrive
# does not lock the database while the project lives in Desktop.
# DATABASE_PATH=

# Set to 1 when a reverse proxy on this computer accepts https and forwards to GuildLink.
# TRUST_PROXY=1

# The https address other people open. The bot uses it when it points someone at the panel.
# PUBLIC_URL=https://panel.example.com

# Published installs apply new commits from git. Set this to 0 to stay on the current version.
# GUILDLINK_UPDATE=0

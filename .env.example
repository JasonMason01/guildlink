# Bot token from the Discord Developer Portal, Bot tab.
DISCORD_TOKEN=

# Application id, OAuth2 tab.
DISCORD_CLIENT_ID=

# OAuth2 client secret. Reset it if it is ever exposed.
DISCORD_CLIENT_SECRET=

# Must match the redirect you add under OAuth2 → Redirects.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Long random string. Used to seal session cookies and stored Discord tokens.
SESSION_SECRET=

PORT=3000
HOST=127.0.0.1

# Optional. Defaults to %LOCALAPPDATA%\guildlink\guildlink.db so OneDrive
# does not lock the database while the project lives in Desktop.
# DATABASE_PATH=

# Set to 1 when the panel is behind a reverse proxy that sets X-Forwarded-*.
# TRUST_PROXY=0

# Public panel URL, used in bot replies. Defaults to http://localhost:PORT.
# PUBLIC_URL=http://localhost:3000

# Published installs apply new commits from git. Set this to 0 to stay on the current version.
# GUILDLINK_UPDATE=0
